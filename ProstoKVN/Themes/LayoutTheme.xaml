<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- One spacing and hierarchy system, shared across all five pages. -->
 <Style x:Key="PageTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="PageDescription" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,7,0,23"/>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontSize" Value="12.5"/>
  <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="FormHint" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,0"/>
 </Style>
 <Style x:Key="PageScroll" TargetType="ScrollViewer">
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="PanningMode" Value="VerticalOnly"/><Setter Property="Padding" Value="26,26,28,30"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <Style x:Key="PageStack" TargetType="StackPanel"><Setter Property="MaxWidth" Value="920"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
 <Style x:Key="Card" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/>
  <Setter Property="Margin" Value="0,0,0,16"/>
 </Style>
 <!-- Every expander uses the same header, icon, border and active-state conventions. -->
 <Style x:Key="CompactSectionStyle" TargetType="Expander">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Margin" Value="0,0,0,16"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Expander">
    <Border x:Name="SectionFrame" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ToggleButton x:Name="SectionToggle" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
       FocusVisualStyle="{DynamicResource StudioFocusRing}" Cursor="Hand" MinHeight="52">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="11" Padding="18,14">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
          <ContentPresenter Content="{Binding Header,RelativeSource={RelativeSource AncestorType=Expander}}"
           VerticalAlignment="Center" HorizontalAlignment="Stretch" TextElement.FontSize="14"
           TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
          <TextBlock x:Name="Arrow" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
           FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Border x:Name="SectionContent" Grid.Row="1" Visibility="Collapsed" Padding="18,4,18,20">
       <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"/>
      </Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SectionFrame" Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="SubSectionStyle" TargetType="Expander" BasedOn="{StaticResource CompactSectionStyle}">
  <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
  <Setter Property="Margin" Value="0,14,0,4"/>
 </Style>
 <Style x:Key="CompactRuleGroupStyle" TargetType="Expander" BasedOn="{StaticResource CompactSectionStyle}">
  <Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="OpenSection" TargetType="Expander">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14"><ContentPresenter ContentSource="Content"/></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="EditorSection" TargetType="Expander" BasedOn="{StaticResource CompactSectionStyle}">
  <Style.Triggers><Trigger Property="IsExpanded" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
 <!-- Consistent left navigation: icon, full label, active rail, and no compacted text. -->
 <Style TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="MinHeight" Value="47"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabItem">
    <Border x:Name="NavItem" Background="Transparent" CornerRadius="10"
      BorderBrush="Transparent" BorderThickness="1" ToolTip="{TemplateBinding Header}">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="3"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="ActiveRail" Background="Transparent" CornerRadius="2" Margin="0,10,0,10"/>
      <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17"
       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,0,0"/>
      <ContentPresenter Grid.Column="2" ContentSource="Header" Margin="9,0,8,0"
       VerticalAlignment="Center" HorizontalAlignment="Stretch"
       TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource SurfaceHover}"/>
     </Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter TargetName="ActiveRail" Property="Background" Value="{DynamicResource AccentSolid}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True">
      <Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style TargetType="TabControl">
  <Setter Property="TabStripPlacement" Value="Left"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="TabControl">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="14,22,14,18">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="11,0,0,23">
        <TextBlock Text="РАЗДЕЛЫ" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="SemiBold"/>
       </StackPanel>
       <StackPanel Grid.Row="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
       <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" CornerRadius="9" Padding="12,13">
        <StackPanel>
         <TextBlock Text="PROSTOKVN" Foreground="{DynamicResource AccentText}" FontSize="10" FontWeight="SemiBold"/>
         <TextBlock Text="Сайты и приложения настраиваются в разделе «Маршрутизация»."
          TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
     <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextElement.FontWeight="Normal"
      TextElement.Foreground="{DynamicResource TextPrimary}"/>
    </Grid>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
</ResourceDictionary>