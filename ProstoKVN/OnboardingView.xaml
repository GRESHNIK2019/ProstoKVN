<UserControl x:Class="ProstoKVN.OnboardingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource ThemeBgF3F6F2}" Foreground="{DynamicResource ThemeFg193B3E}"
 FontFamily="Segoe UI Variable" MinWidth="380">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="Themes/PaletteLight.xaml"/>
  <ResourceDictionary Source="Themes/StudioTheme.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="SetupPanel" Margin="24,18" MaxWidth="620" VerticalAlignment="Center">
  <StackPanel>
   <TextBlock Text="Начнём с вашей подписки" FontFamily="Segoe UI Variable" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="Вставьте HTTPS-подписку или отдельную VLESS-ссылку — мы добавим сервер."
              Foreground="{DynamicResource ThemeFg66817C}" FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>
   <TextBlock Text="Ссылка подписки" FontSize="12" Margin="0,0,0,6"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="LinkBox" Height="38" VerticalContentAlignment="Center" FontSize="13" MaxLength="8192"
             Margin="0,0,8,0" AutomationProperties.Name="Ссылка подписки" ToolTip="HTTPS-подписка или vless:// ссылка"/>
    <Button x:Name="PasteButton" Grid.Column="1" Content="Вставить" Click="Paste_Click"
            Style="{StaticResource TertiaryButton}" Padding="13,8" Margin="0"/>
   </Grid>
   <TextBlock x:Name="FeedbackText" Text="Поддерживаются https:// и vless://."
              Foreground="{DynamicResource ThemeFg62827C}" FontSize="12" TextWrapping="Wrap"
              MinHeight="32" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,7,0,10"
              ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="SubmitButton" Content="Добавить подписку" Click="Submit_Click" Padding="15,9" IsDefault="True"/>
    <Button x:Name="LaterButton" Content="Позже" Click="Later_Click" Style="{StaticResource TertiaryButton}" Padding="15,9"/>
   </StackPanel>
   <TextBlock Text="Ссылка хранится зашифрованной в профиле Windows." Foreground="{DynamicResource ThemeFg66817C}"
              FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
