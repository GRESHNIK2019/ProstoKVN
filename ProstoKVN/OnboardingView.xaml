<UserControl x:Class="ProstoKVN.OnboardingView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource ThemeBgF3F6F2}" Foreground="{DynamicResource ThemeFg193B3E}" FontFamily="Segoe UI Variable" MinWidth="380">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/PaletteLight.xaml"/><ResourceDictionary Source="Themes/StudioTheme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
   PanningMode="VerticalOnly" Background="{DynamicResource ThemeBgF3F6F2}">
  <Grid MaxWidth="760" Margin="25,17,25,20" VerticalAlignment="Center">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="17"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource ThemeBg183F43}" CornerRadius="15" Height="122" ClipToBounds="True">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="144"/></Grid.ColumnDefinitions>
     <StackPanel Margin="23,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="Первое подключение" FontFamily="Bahnschrift" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource ThemeFgF1FFF6}" Margin="0,0,0,6"/>
      <TextBlock Text="Добавь подписку — выбери сервер — подключись." FontSize="13" Foreground="{DynamicResource ThemeFgB6DDD1}" TextWrapping="Wrap"/>
     </StackPanel>
     <Canvas Grid.Column="1" Width="135" Height="115" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0.55">
      <Ellipse Canvas.Left="2" Canvas.Top="-10" Width="135" Height="135" Stroke="{DynamicResource ThemeStroke80B5A6}" StrokeThickness="1"/>
      <Ellipse Canvas.Left="27" Canvas.Top="15" Width="85" Height="85" Stroke="{DynamicResource ThemeStrokeA1DCC8}" StrokeThickness="1.5"/>
      <Ellipse Canvas.Left="51" Canvas.Top="39" Width="37" Height="37" Stroke="{DynamicResource ThemeStrokeA1DCC8}" StrokeThickness="2"/>
      <Line X1="0" Y1="58" X2="135" Y2="58" Stroke="{DynamicResource ThemeStroke74AD9C}" StrokeThickness="1"/>
      <Line X1="68" Y1="0" X2="68" Y2="115" Stroke="{DynamicResource ThemeStroke74AD9C}" StrokeThickness="1"/>
     </Canvas>
    </Grid>
   </Border>
   <Border Grid.Row="2" Background="{DynamicResource ThemeBgFFFFFF}" BorderBrush="{DynamicResource ThemeBorderD6E3DC}" BorderThickness="1" CornerRadius="14" Padding="20,17">
    <StackPanel>
     <TextBlock Text="Ссылка подписки" FontFamily="Bahnschrift" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="Поддерживаются ссылки 3x-ui. Данные останутся в профиле Windows." Foreground="{DynamicResource ThemeFg62837D}" FontSize="12" Margin="0,5,0,11"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="LinkBox" Grid.Column="0" Height="42" VerticalContentAlignment="Center"
       FontSize="13" MaxLength="4096" Margin="0,0,8,0" ToolTip="HTTPS-ссылка на подписку" AutomationProperties.Name="Subscription HTTPS link"/>
      <Button x:Name="PasteButton" Grid.Column="1" Content="Вставить" Click="Paste_Click" Padding="14,9" Background="{DynamicResource ThemeBgE1EEE6}" Foreground="{DynamicResource ThemeFg245950}" Margin="0"/>
     </Grid>
     <TextBlock x:Name="FeedbackText" Text="Вставь ссылку, которую выдал провайдер." Foreground="{DynamicResource ThemeFg62827C}"
      FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
      <Button x:Name="SubmitButton" Content="Проверить и добавить серверы" Click="Submit_Click" Padding="17,11"/>
      <Button x:Name="LaterButton" Content="Позже" Click="Later_Click" Background="{DynamicResource ThemeBgE1EEE6}" Foreground="{DynamicResource ThemeFg245950}" Padding="16,11"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <TextBlock Grid.Row="4" Text="После добавления подписки появится список серверов. Режим TUN можно включить в настройках."
    FontSize="12" Foreground="{DynamicResource ThemeFg63817C}" TextWrapping="Wrap" Margin="3,0,0,0"/>
  </Grid>
 </ScrollViewer>
</UserControl>