<UserControl x:Class="ProstoKVN.OnboardingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PaletteLight.xaml"/><ResourceDictionary Source="Themes/StudioTheme.xaml"/><ResourceDictionary Source="Themes/LayoutTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
  <Grid x:Name="SetupPanel" MaxWidth="620" VerticalAlignment="Center"><StackPanel>
   <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ В PROSTOKVN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,0,0,14"/>
   <TextBlock Text="Ваше первое подключение" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Добавьте ссылку от VPN-провайдера. Мы загрузим серверы и подготовим всё для подключения." Style="{StaticResource PageDescription}"/>
   <Border Style="{StaticResource Card}" Padding="24"><StackPanel>
    <TextBlock Text="Ссылка подписки" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="LinkBox" MaxLength="8192" AutomationProperties.Name="Ссылка подписки" ToolTip="HTTPS-подписка или vless:// ссылка"/>
    <Button x:Name="PasteButton" Content="Вставить из буфера" Click="Paste_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,6,0,4" Padding="0,6"/>
    <TextBlock x:Name="FeedbackText" Text="Поддерживаются HTTPS-подписки и отдельные VLESS-ссылки." Style="{StaticResource FormHint}" Margin="0,0,0,20"/>
    <WrapPanel><Button x:Name="SubmitButton" Content="Добавить подписку" Click="Submit_Click" IsDefault="True" Margin="0,0,8,6"/><Button x:Name="LaterButton" Content="Настроить позже" Click="Later_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,6"/></WrapPanel>
   </StackPanel></Border>
   <TextBlock Text="Ссылка хранится зашифрованной в вашем профиле Windows." Style="{StaticResource FormHint}" HorizontalAlignment="Center" Margin="0"/>
  </StackPanel></Grid>
 </ScrollViewer>
</UserControl>
