<Window x:Class="ProstoKVN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProstoKVN" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="ProstoKVN" Height="440" Width="660" MinWidth="620" MinHeight="440" Icon="Assets/ProstoKVN.ico"
 Background="{DynamicResource ThemeBgF3F6F2}" Foreground="{DynamicResource ThemeFg193B3E}" FontFamily="Segoe UI Variable" FontSize="13" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Window.Resources>

 <ResourceDictionary>

  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PaletteLight.xaml"/><ResourceDictionary Source="Themes/StudioTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeFg193B3E}"/><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource ThemeFg66817C}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
 <Style x:Key="CompactSectionStyle" TargetType="{x:Type Expander}">
  <Setter Property="Foreground" Value="{DynamicResource ThemeFg173B3E}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderD5E3DD}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="0,8"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type Expander}">
     <Border x:Name="SectionFrame" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
      <DockPanel LastChildFill="True">
       <ToggleButton x:Name="SectionToggle" DockPanel.Dock="Top"
                     IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     Content="{TemplateBinding Header}" Padding="{TemplateBinding Padding}"
                     Background="Transparent" Foreground="{TemplateBinding Foreground}"
                     BorderThickness="0" Cursor="Hand">
        <ToggleButton.Template>
         <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="HeaderSurface" Padding="{TemplateBinding Padding}"
                  Background="Transparent" CornerRadius="6">
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontFamily="Segoe UI Variable"
                              TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
            <Path x:Name="AccordionArrow" Grid.Column="1" Width="13" Height="9"
                  Data="M 1,1 L 6.5,7 L 12,1" StrokeThickness="2"
                  Stroke="{DynamicResource ThemeFg608079}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right"
                  VerticalAlignment="Center">
             <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
            </Path>
           </Grid>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="AccordionArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThemeBgEFF5F1}"/>
           </Trigger>
           <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThemeBgEAF3ED}"/>
           </Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ThemeBgEAF3ED}"/>
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Border x:Name="AccordionContent" Visibility="Collapsed"
               BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}"
               Padding="0,6,0,10">
        <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
       </Border>
      </DockPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True">
       <Setter TargetName="AccordionContent" Property="Visibility" Value="Visible"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="CompactRuleGroupStyle" TargetType="{x:Type Expander}"
        BasedOn="{StaticResource CompactSectionStyle}">
  <Setter Property="Padding" Value="10,5"/>
  <Setter Property="Margin" Value="0,0,0,4"/>
  <Setter Property="Background" Value="{DynamicResource ThemeBgEFF5F1}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderC9DBD4}"/>
 </Style>


 </ResourceDictionary>

</Window.Resources>
<Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="18,0,8,0">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
   <Grid Width="22" Height="22" Margin="0,0,9,0">
    <Path Data="M3,16 L3,10 A7,7 0 0 1 17,10 L17,16 M7,16 L7,10 A3,3 0 0 1 13,10 L13,16" Stroke="{DynamicResource AccentText}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   </Grid>
   <TextBlock Text="ProstoKVN" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <TextBlock x:Name="VersionText" Text="0.33" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="9,3,0,0" VerticalAlignment="Center"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button x:Name="ThemeButton" Content="Тёмная" Click="ThemeButton_Click" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,9,0" Padding="10,6"/>
   <Border Width="1" Height="14" Background="{DynamicResource Line}" Margin="0,0,7,0"/>
   <Button x:Name="MinimizeWindowButton" Content="&#xE921;" Click="MinimizeWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно"/>
   <Button x:Name="MaximizeWindowButton" Content="&#xE922;" Click="MaximizeWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="Развернуть или восстановить" AutomationProperties.Name="Развернуть или восстановить окно"/>
   <Button x:Name="CloseWindowButton" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть приложение"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/><Setter Property="Foreground" Value="{DynamicResource DangerInk}"/></Trigger></Style.Triggers></Style></Button.Style></Button>
  </StackPanel>
 </Grid>
 <Grid Grid.Row="1">
  <TabControl x:Name="MainTabs">
   <TabItem Header="Подключение">
    <Grid x:Name="HomePanel" Margin="20,18,20,16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="ConnectionStateBadge" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
       <TextBlock x:Name="ConnectionIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
       <TextBlock x:Name="ConnectionTitle" Text="VPN выключен" FontSize="22" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
       <TextBlock x:Name="ConnectionHint" Text="Выберите сервер и подключитесь." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
      <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource PowerButton}" Content="Подключиться" Click="Connect_Click" Width="156" Height="40" FontSize="12" Margin="0" VerticalAlignment="Center"/>
      <Button x:Name="DisconnectButton" Grid.Column="2" Style="{StaticResource TertiaryButton}" Content="Отменить" Click="Disconnect_Click" Visibility="Collapsed" Width="156" Height="40" FontSize="12" Margin="0" VerticalAlignment="Center"/>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="1"/><RowDefinition Height="50"/></Grid.RowDefinitions>
       <ComboBox x:Name="ServerBox" Tag="Сервер подключения" Background="Transparent" BorderThickness="0" Margin="1" FontSize="14"
        SelectionChanged="ServerBox_SelectionChanged" AutomationProperties.Name="Сервер VPN">
        <ComboBox.ToolTip><StackPanel><TextBlock Text="{Binding SelectedItem,ElementName=ServerBox}" TextWrapping="Wrap" MaxWidth="310"/><TextBlock Text="{Binding Text,ElementName=ServerHint}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="310" Margin="0,5,0,0"/></StackPanel></ComboBox.ToolTip>
       </ComboBox>
       <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="14,0"/>
       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
        <TextBlock Text="Режим подключения" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="ModeBox" Grid.Column="1" Height="38" Margin="0,0,7,0" Background="Transparent" BorderThickness="0" FontSize="13"
         SelectionChanged="ModeBox_SelectionChanged" AutomationProperties.Name="Режим VPN" ToolTip="{Binding Text,ElementName=ModeDescription}">
         <ComboBoxItem Tag="smart" Content="Умный режим"/><ComboBoxItem Tag="vpn" Content="Весь интернет через VPN"/><ComboBoxItem Tag="direct" Content="Без VPN"/>
        </ComboBox>
       </Grid>
      </Grid>
     </Border>
     <TextBlock x:Name="ServerHint" Visibility="Collapsed"/><TextBlock x:Name="ModeDescription" Visibility="Collapsed"/>
     <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="CoverageSettingsButton" Content="Изменить" Click="SettingsLink_Click" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" FontSize="12" Margin="0" Padding="9,5"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="2,0,8,0"/>
       <TextBlock x:Name="CoverageHint" Text="Браузер и системный прокси" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
     </DockPanel>
     <Border x:Name="PendingSettingsBanner" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,7" Margin="0,12,0,0">
      <DockPanel><Button DockPanel.Dock="Right" Content="Применить" Click="ApplyConnectionSettings_Click" Margin="10,0,0,0" Padding="10,5" FontSize="12"/>
       <TextBlock Text="Настройки изменены" VerticalAlignment="Center" FontSize="12" ToolTip="Переподключитесь, чтобы применить настройки."/></DockPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Подписки"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,16">
    <TextBlock Text="Подписки" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Серверы из ваших подписок." Style="{StaticResource PageDescription}"/>
   <Expander x:Name="SubscriptionSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="True">
    <Expander.Header>
     <DockPanel LastChildFill="True">
      <TextBlock x:Name="ImportSummary" DockPanel.Dock="Right" Text="Нет подписок"
                 Foreground="{DynamicResource ThemeFg608079}" FontSize="11"
                 Margin="10,0,9,0" VerticalAlignment="Center" MaxWidth="170"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="Источники серверов" FontWeight="SemiBold" FontSize="13"
                 Foreground="{DynamicResource ThemeFg173B3E}" VerticalAlignment="Center"/>
     </DockPanel>
    </Expander.Header>
    <StackPanel>
     <ListBox x:Name="SubscriptionList" MinHeight="40" MaxHeight="192"
              SelectionChanged="SubscriptionList_SelectionChanged"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Background="Transparent"
              BorderThickness="0"
              Margin="0,0,0,9" Padding="0"
              ToolTip="Выбери подписку для редактирования. Ссылки здесь не показываются.">
      <ListBox.ItemContainerStyle>
       <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
           <Border x:Name="ProfileCard" Background="{DynamicResource ThemeBgEFF5F1}"
                   BorderBrush="{DynamicResource ThemeBorderC9DBD4}" BorderThickness="1"
                   CornerRadius="9" Padding="{TemplateBinding Padding}">
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
             <Border x:Name="ProfileAccent" Grid.Column="0" Width="4"
                     CornerRadius="2" Background="{DynamicResource RuleSelectedAccent}"
                     Visibility="Collapsed"/>
             <StackPanel Grid.Column="1" Margin="11,0,2,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                         Foreground="{DynamicResource ThemeFg173B3E}"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
               <TextBlock Text="{Binding DetectedFormat}" FontSize="11"
                          Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text="{Binding NodeCount}" FontSize="11"
                          Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text=" серверов" FontSize="11" Foreground="{DynamicResource ThemeFg66817C}"/>
              </StackPanel>
             </StackPanel>
            </Grid>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="ProfileCard" Property="Background"
                     Value="{DynamicResource RuleRowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
             <Setter TargetName="ProfileCard" Property="Background"
                     Value="{DynamicResource RuleSelectedBackground}"/>
             <Setter TargetName="ProfileCard" Property="BorderBrush"
                     Value="{DynamicResource RuleSelectedBorder}"/>
             <Setter TargetName="ProfileAccent" Property="Visibility" Value="Visible"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </ListBox.ItemContainerStyle>
     </ListBox>
     <TextBlock x:Name="SubscriptionsEmptyText" Text="Пока нет подписок. Нажмите «Добавить» и вставьте ссылку от провайдера." TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel Margin="0,0,0,10">
      <Button x:Name="NewSubscriptionButton" Content="Добавить"
              Click="NewSubscription_Click" Margin="0,0,8,0"
              Style="{StaticResource TertiaryButton}"/>
      <Button x:Name="EditSubscriptionButton" Content="Изменить" Click="EditSubscription_Click" IsEnabled="False" Margin="0,0,8,0" Style="{StaticResource TertiaryButton}"/>
      <Button x:Name="RemoveSubscriptionButton" Content="Удалить"
              Click="RemoveSubscription_Click" IsEnabled="False" Margin="0,0,8,0"
              Style="{StaticResource DangerButton}"/>
      <Button x:Name="RefreshAllSubscriptionsButton" Content="Обновить" ToolTip="Обновить все подписки"
              Click="RefreshAllSubscriptions_Click" Style="{StaticResource TertiaryButton}"/>
     </WrapPanel>
     <Expander x:Name="SubscriptionEditor" Header="Добавить подписку" Style="{StaticResource CompactSectionStyle}" IsExpanded="False"><StackPanel>
     <TextBlock Text="Название (необязательно)" FontSize="12" Foreground="{DynamicResource ThemeFg66817C}"
                Margin="0,0,0,4"/>
     <TextBox x:Name="SubscriptionNameBox" Height="34" MaxLength="96"
              ToolTip="Название источника серверов" Margin="0,0,0,10"/>
     <TextBlock Text="HTTPS-подписка или VLESS-ссылка" FontSize="12"
                Foreground="{DynamicResource ThemeFg66817C}" Margin="0,0,0,4"/>
     <TextBox AutomationProperties.Name="HTTPS-подписка или VLESS-ссылка" x:Name="SubscriptionBox" Height="36" MaxLength="8192"
              ToolTip="Секретная ссылка сохраняется зашифрованной через Windows DPAPI"
              Margin="0,0,0,10"/>
     <Expander Header="Дополнительные параметры" Style="{StaticResource CompactSectionStyle}"><StackPanel>
     <TextBlock Text="Формат" FontSize="12"
                Foreground="{DynamicResource ThemeFg66817C}" Margin="0,0,0,4"/>
     <ComboBox x:Name="SubscriptionFormatBox" Height="35" SelectedIndex="0" Margin="0,0,0,10">
      <ComboBoxItem Tag="auto" Content="Автоматическое определение (рекомендуется)"/>
      <ComboBoxItem Tag="base64" Content="Base64 / V2Ray"/>
      <ComboBoxItem Tag="mihomo" Content="Mihomo / Clash YAML"/>
      <ComboBoxItem Tag="singbox" Content="sing-box JSON"/>
      <ComboBoxItem Tag="xray" Content="Xray JSON"/>
     </ComboBox>
     </StackPanel></Expander>
     <WrapPanel>
      <Button x:Name="ImportButton" Content="Добавить сервер / подписку"
              Click="Import_Click" Margin="0,0,9,0"/>
      <TextBlock x:Name="ProfileStatusText" Text="Ссылки хранятся зашифрованными в профиле Windows"
                 Foreground="{DynamicResource ThemeFg66817C}" FontSize="11.5"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
     </WrapPanel>
    </StackPanel></Expander>
    </StackPanel>
   </Expander>

   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Правила">

    <ScrollViewer x:Name="RulesPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="22,15,22,20">

     <StackPanel Margin="3">

      <TextBlock Text="Сайты и приложения" Style="{StaticResource PageTitle}"/><TextBlock Text="Выберите сайты и приложения для подключения через VPN, напрямую или блокировки." Foreground="{DynamicResource ThemeFg6A8580}" Margin="0,0,0,9" FontSize="12" TextWrapping="Wrap"/>

      <Button Content="Добавить правило" Click="NewRule_Click" HorizontalAlignment="Left" Margin="0,4,0,12"/>
      <TextBlock Text="Найти сайт, сервис или название" FontSize="12" Margin="0,0,0,6"/>
      <TextBox x:Name="RuleSearchBox" TextChanged="RuleSearch_Changed" Height="38" Padding="10,3" Margin="0,0,0,12" ToolTip="Поиск по сайту, сервису или названию" AutomationProperties.Name="Поиск правил"/>
      <Expander x:Name="AddRuleSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="False" Header="Новое правило">

       <StackPanel Orientation="Vertical">

        <WrapPanel Margin="0,0,0,8">
         <ComboBox x:Name="RuleTargetKindBox" Width="180" Height="33" SelectedIndex="0"
                   SelectionChanged="RuleTargetKind_Changed" Margin="0,0,8,0" AutomationProperties.Name="Тип правила">
          <ComboBoxItem Content="Сайт / IP" Tag="address"/>
          <ComboBoxItem Content="Приложение" Tag="application"/>
         </ComboBox>
         <Button x:Name="ChooseApplicationButton" Content="Выбрать .exe…" Click="ChooseApplication_Click"
                 Visibility="Collapsed" Height="33" Padding="10,5" Margin="0"/>
        </WrapPanel>
        <TextBlock x:Name="RuleTargetCaption" Text="Адрес сайта или IP, способ подключения и сервер" Margin="0,0,0,7" FontSize="12"/>
<Grid>

         <Grid.ColumnDefinitions>

          <ColumnDefinition Width="*"/>

          <ColumnDefinition Width="142"/>

          <ColumnDefinition Width="159"/>

          <ColumnDefinition Width="Auto"/>

         </Grid.ColumnDefinitions>

         <TextBox AutomationProperties.Name="Сайт, IP-адрес или подсеть" x:Name="DomainBox" Grid.Column="0" MinWidth="105" Height="33" Padding="8,2" Margin="0,0,6,0" FontSize="12"

                  ToolTip="Домен: example.com  •  IP: 8.8.8.8  •  Подсеть: 1.2.3.0/24  •  IPv6: 2001:db8::/32"/>

         <ComboBox x:Name="RuleRouteBox" Grid.Column="1" Height="33" Margin="0,0,6,0"

                   SelectedIndex="0" SelectionChanged="RuleRouteBox_SelectionChanged" FontSize="12">

          <ComboBoxItem Content="Напрямую" Tag="DIRECT"/><ComboBoxItem Content="Через VPN" Tag="VEGA"/><ComboBoxItem Content="Блокировать" Tag="REJECT"/>

         </ComboBox>

         <ComboBox x:Name="RuleNodeBox" Grid.Column="2" Height="33" Margin="0,0,6,0"

                   IsEnabled="False" FontSize="12"/>

         <Button Grid.Column="3" Content="Сохранить" Click="AddRule_Click" Margin="0" Padding="9,7"/>

        </Grid>

        <Grid Margin="0,7,0,0">

         <Grid.ColumnDefinitions>

          <ColumnDefinition Width="Auto"/>

          <ColumnDefinition Width="*"/>

         </Grid.ColumnDefinitions>

         <TextBlock Grid.Column="0" Text="Название (необязательно):" Margin="0,7,8,0"

                    Foreground="{DynamicResource ThemeFg476F6E}" FontSize="11.5"/>

         <TextBox x:Name="RuleLabelBox" Grid.Column="1" Height="30" Padding="8,2" MaxLength="96"

                  FontSize="12" ToolTip="Необязательно. Пример: Telegram, домашняя сеть, рабочий сервер"

                  VerticalContentAlignment="Center"/>

        </Grid>

        <TextBlock x:Name="ApplicationRuleHint" Visibility="Collapsed" Text="Выберите .exe или введите имя, например chrome.exe. Полный путь — только этот файл; имя — все копии приложения. Для всех соединений включите TUN с правами администратора. Правило приложения имеет приоритет над правилами сайтов и IP; в режиме DIRECT исключения отключены. После обновления приложения проверьте путь."
                   Foreground="{DynamicResource ThemeFg62807C}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
        <TextBlock x:Name="RuleAddressHint" Text="Например: 149.154.160.0/20 — Telegram. Выбери исключение в списке, чтобы изменить название или маршрут." Foreground="{DynamicResource ThemeFg62807C}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>

       </StackPanel>

      </Expander>

      <Expander x:Name="RuleGroupsSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="True" Header="Сохранённые правила">

       <DockPanel>

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,10,0,0">
         <Button x:Name="EditRuleButton" DockPanel.Dock="Right" Content="Изменить" Click="EditRule_Click" IsEnabled="False" Style="{StaticResource TertiaryButton}" Margin="8,0,0,0" Padding="11,7"/>
<Button x:Name="RemoveRuleButton" DockPanel.Dock="Right"
                 Content="Удалить выбранное" Click="RemoveRule_Click"
                 IsEnabled="False" HorizontalAlignment="Right"
                 Style="{StaticResource DangerButton}" Padding="11,7" Margin="8,0,0,0"/>
         <TextBlock x:Name="SelectedRuleHint" Text="Выберите правило для изменения или удаления"
                    FontSize="11" Foreground="{DynamicResource ThemeFg608079}"
                    VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                    Margin="0,0,7,0"/>
        </DockPanel>

        <!-- Outer page owns scrolling: removing the nested ListBox ScrollViewer

             keeps mouse-wheel scrolling predictable even over expanded items. -->

        <StackPanel><TextBlock x:Name="RulesEmptyText" Text="Правила не найдены. Измените поиск или добавьте правило." Visibility="Collapsed" Margin="0,4,0,12" TextWrapping="Wrap"/>
        <ListBox x:Name="RulesList" Background="Transparent" Foreground="{DynamicResource ThemeFg1A3E42}"

                 BorderThickness="0" FontSize="12.5" KeyboardNavigation.TabNavigation="Continue"

                 SelectionChanged="RulesList_SelectionChanged">

         <ListBox.Template>

          <ControlTemplate TargetType="{x:Type ListBox}">

           <ItemsPresenter/>

          </ControlTemplate>

         </ListBox.Template>

         <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
           <Setter Property="Padding" Value="9,5"/>
           <Setter Property="Margin" Value="0,0,0,2"/>
           <Setter Property="FontSize" Value="12"/>
           <Setter Property="Foreground" Value="{DynamicResource ThemeFg1A3E42}"/>
           <Setter Property="Background" Value="Transparent"/>
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
           <Setter Property="Cursor" Value="Hand"/>
           <EventSetter Event="PreviewMouseRightButtonDown" Handler="RuleItem_RightButtonDown"/>
           <Setter Property="ContextMenu">
            <Setter.Value>
             <ContextMenu/>
            </Setter.Value>
           </Setter>
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border x:Name="RuleRowFrame" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="6" Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
               <Grid>
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="4"/>
                 <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="RuleSelectedMarker" Grid.Column="0"
                        Background="{DynamicResource RuleSelectedAccent}"
                        Width="4" CornerRadius="2" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock x:Name="RuleRowText" Text="{Binding DisplayTarget}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
                 <TextBlock Text="{Binding DisplaySummary}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource ThemeFg66817C}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
               </Grid>
              </Border>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RuleRowFrame" Property="Background"
                        Value="{DynamicResource RuleRowHover}"/>
               </Trigger>
               <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="RuleRowFrame" Property="BorderBrush"
                        Value="{DynamicResource RuleSelectedBorder}"/>
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RuleRowFrame" Property="Background"
                        Value="{DynamicResource RuleSelectedBackground}"/>
                <Setter TargetName="RuleRowFrame" Property="BorderBrush"
                        Value="{DynamicResource RuleSelectedBorder}"/>
                <Setter TargetName="RuleSelectedMarker" Property="Visibility"
                        Value="Visible"/>
                <Setter TargetName="RuleRowText" Property="Foreground"
                        Value="{DynamicResource RuleSelectedForeground}"/>
                <Setter TargetName="RuleRowText" Property="FontWeight"
                        Value="SemiBold"/>
               </Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </ListBox.ItemContainerStyle>

         <ListBox.GroupStyle>

          <GroupStyle>

           <GroupStyle.ContainerStyle>

            <Style TargetType="{x:Type GroupItem}">

             <Setter Property="Template">

              <Setter.Value>

               <ControlTemplate TargetType="{x:Type GroupItem}">

                <Expander IsExpanded="False" Loaded="ServiceGroup_Loaded" Expanded="ServiceGroup_Expanded" Collapsed="ServiceGroup_Collapsed" Style="{StaticResource CompactRuleGroupStyle}">

                 <Expander.Header>

                  <DockPanel LastChildFill="True" Margin="2,0,1,0">

                   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">

                    <TextBlock Text="{Binding ItemCount}" Foreground="{DynamicResource ThemeFg587B79}" FontSize="12"/>

                    <TextBlock Text=" правил" Foreground="{DynamicResource ThemeFg587B79}" FontSize="12"/>

                   </StackPanel>

                   <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"

                              Foreground="{DynamicResource ThemeFg173B3E}"/>

                  </DockPanel>

                 </Expander.Header>

                 <ItemsPresenter Margin="2,4,2,4"/>

                </Expander>

               </ControlTemplate>

              </Setter.Value>

             </Setter>

            </Style>

           </GroupStyle.ContainerStyle>

          </GroupStyle>

         </ListBox.GroupStyle>

        </ListBox></StackPanel>

       </DockPanel>

      </Expander>



     </StackPanel>

    </ScrollViewer>

   </TabItem>


   <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,14">
    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Охват приложений и автоматические правила." Style="{StaticResource PageDescription}"/>
    <Expander x:Name="RoutingSection" Header="Подключение" Style="{StaticResource CompactSectionStyle}" IsExpanded="True"><StackPanel>
     <CheckBox x:Name="TunBox" Content="Использовать VPN для всех приложений" Click="SettingsChanged_Click"/>
     <TextBlock Text="Для игр и звонков. Нужны права администратора." TextWrapping="Wrap" Foreground="{DynamicResource ThemeFg66817C}" FontSize="12" Margin="45,0,0,10" ToolTip="Включает сетевой адаптер TUN для всех приложений."/>
     <CheckBox x:Name="AutoLearnBox" Content="Находить сайты, которым нужен VPN" IsChecked="True" Click="SettingsChanged_Click"/>
     <TextBlock Text="Запоминает рабочий маршрут для недоступных сайтов." TextWrapping="Wrap" Foreground="{DynamicResource ThemeFg66817C}" FontSize="12" Margin="45,0,0,4"/>
     <TextBlock x:Name="SettingsApplyHint" Text="Изменения применятся при следующем подключении." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
     <Button x:Name="ApplySettingsButton" Content="Переподключиться и применить" Click="ApplyConnectionSettings_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
    </StackPanel></Expander>
   <Expander x:Name="UpdateSection" Style="{StaticResource CompactSectionStyle}"
             IsExpanded="False">
    <Expander.Header>
     <DockPanel LastChildFill="True">
      <TextBlock x:Name="UpdateStatusText" DockPanel.Dock="Right" Text="Не проверено"
                 Foreground="{DynamicResource ThemeFg608079}" FontSize="11"
                 Margin="12,0,10,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center"/>
      <TextBlock Text="Обновления" FontWeight="SemiBold" FontSize="14"
                 Foreground="{DynamicResource ThemeFg173B3E}" VerticalAlignment="Center"/>
     </DockPanel>
    </Expander.Header>
    <StackPanel>
     <TextBlock Text="Проверка официальных стабильных релизов GitHub. Установка выполняется только после подтверждения."
                Foreground="{DynamicResource ThemeFg66817C}" FontSize="12"
                TextWrapping="Wrap" Margin="0,0,0,10"/>
     <Button x:Name="CheckUpdateButton" Content="Проверить обновления"
             Click="CheckUpdate_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </Expander>

   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Помощь"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,16">
    <TextBlock Text="Помощь" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Проверка сайтов и сведения о соединении." Style="{StaticResource PageDescription}"/>
    <TextBlock x:Name="StatusLabel" Text="Не подключено" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,12"/>
    <WrapPanel Margin="0,0,0,12"><Button Content="Нет серверов" Click="SubscriptionsLink_Click" Style="{StaticResource TertiaryButton}" ToolTip="Открыть подписки и загрузить серверы"/><Button Content="Не работают игры или звонки" Click="SettingsLink_Click" Style="{StaticResource TertiaryButton}" ToolTip="Настроить VPN для всех приложений"/></WrapPanel>
    <Expander x:Name="ConnectionDetailsSection" Header="Сведения о подключении" Style="{StaticResource CompactSectionStyle}" IsExpanded="False"><StackPanel>
     <TextBlock x:Name="RecoveryText" Text="Подключитесь, чтобы начать проверку." TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
     <TextBlock x:Name="LatencyText" Text="HTTPS-задержка: нет данных" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
     <TextBlock x:Name="UdpText" Text="UDP: нет данных" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
     <TextBlock x:Name="EngineInfoLabel" Text="Ядро выбирается автоматически." TextWrapping="Wrap" FontSize="12" Margin="0,7,0,10"/>
     <Button x:Name="RefreshButton" Content="Обновить список серверов" Click="Refresh_Click" Style="{StaticResource TertiaryButton}" HorizontalAlignment="Left"/>
    </StackPanel></Expander>
      <Expander x:Name="ProbeSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="False" Header="Проверить, почему сайт не открывается">

       <StackPanel>

        <StackPanel>

         <TextBlock Text="Адрес сайта, например example.com" Margin="0,0,0,7"/><TextBox AutomationProperties.Name="Сайт для проверки" x:Name="ProbeBox" Height="33" ToolTip="Домен для проверки двух маршрутов"/>

         <WrapPanel Margin="0,7,0,0">

          <Button Content="Сравнить маршруты" Click="Probe_Click" Margin="0,0,7,0" Padding="11,7"/>

          <Button Content="Подобрать маршрут" Click="AutoRoute_Click" Margin="0" Padding="11,7" Background="{DynamicResource ThemeBg276D65}"/>

         </WrapPanel>

        </StackPanel>

        <TextBlock x:Name="ProbeResult" Text="Подключитесь к VPN и введите адрес сайта. Проверка сравнит доступ напрямую и через VPN." Foreground="{DynamicResource ThemeFg6A8580}" Margin="0,12,0,0" TextWrapping="Wrap"/>

       </StackPanel>

      </Expander>
  <Expander x:Name="LogSection" Header="События подключения"
            Style="{StaticResource CompactSectionStyle}" IsExpanded="False"
            Margin="0,0,0,8">
   <Border Background="{DynamicResource ThemeBg183C42}" CornerRadius="8" Padding="9">
    <TextBox x:Name="LogBox" Height="240" IsReadOnly="True" TextWrapping="NoWrap"
             BorderThickness="0" Background="Transparent"
             Foreground="{DynamicResource ThemeFgCDE8D9}"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="11.5" Padding="3"/>
   </Border>
  </Expander>

   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <local:OnboardingView x:Name="OnboardingPanel" Visibility="Collapsed"/>
 </Grid>
</Grid></Border>
</Window>
