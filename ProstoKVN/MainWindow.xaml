<Window x:Class="ProstoKVN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProstoKVN" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 PreviewKeyDown="Window_PreviewKeyDown" Title="ProstoKVN" Width="1040" Height="740" MinWidth="840" MinHeight="620" Icon="Assets/ProstoKVN.ico" Background="{DynamicResource Canvas}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI Variable" FontSize="14" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/PaletteLight.xaml"/><ResourceDictionary Source="Themes/StudioTheme.xaml"/><ResourceDictionary Source="Themes/LayoutTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"/>
  <Grid Margin="18,0,8,0">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
   <Grid Width="22" Height="22" Margin="0,0,9,0">
    <Path Data="M3,16 L3,10 A7,7 0 0 1 17,10 L17,16 M7,16 L7,10 A3,3 0 0 1 13,10 L13,16" Stroke="{DynamicResource AccentText}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   </Grid>
   <TextBlock Text="ProstoKVN" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <TextBlock x:Name="VersionText" Text="0.35.2" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="9,3,0,0" VerticalAlignment="Center"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button x:Name="ThemeButton" Content="Тёмная" Click="ThemeButton_Click" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,0,9,0" Padding="10,6"/>
   <Border Width="1" Height="14" Background="{DynamicResource Line}" Margin="0,0,7,0"/>
   <Button x:Name="MinimizeWindowButton" Content="&#xE921;" Click="MinimizeWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно"/>
   <Button x:Name="MaximizeWindowButton" Content="&#xE922;" Click="MaximizeWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="Развернуть или восстановить" AutomationProperties.Name="Развернуть или восстановить окно"/>
   <Button x:Name="CloseWindowButton" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Свернуть в трей" AutomationProperties.Name="Свернуть в трей"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/><Setter Property="Foreground" Value="{DynamicResource DangerInk}"/></Trigger></Style.Triggers></Style></Button.Style></Button>
  </StackPanel>
 </Grid>

 <Grid Grid.Row="1">
 <TabControl x:Name="MainTabs">
  <TabControl.Style><Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded,ElementName=AddRuleSection}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
  <TabItem Header="Подключение" Tag="&#xE774;">
   <ScrollViewer x:Name="HomePageScroll" Style="{StaticResource PageScroll}">
    <Grid x:Name="HomePanel" MaxWidth="880" VerticalAlignment="Center">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,26"><TextBlock Text="Подключение" Style="{StaticResource PageTitle}"/><TextBlock Text="Сервер, состояние соединения и быстрый доступ к маршрутизации." Style="{StaticResource FormHint}"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,24"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="ConnectionStateBadge" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center"><TextBlock x:Name="ConnectionIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ConnectionTitle" Text="VPN выключен" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ConnectionHint" Text="Выберите сервер и подключитесь." FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
      </Grid>
      <Button x:Name="ConnectButton" Grid.Column="1" Content="Подключиться" Click="Connect_Click" Style="{StaticResource PowerButton}" MinWidth="168" MinHeight="46" Margin="0" VerticalAlignment="Center"/>
      <Button x:Name="DisconnectButton" Grid.Column="1" Content="Отменить" Click="Disconnect_Click" Style="{StaticResource TertiaryButton}" Visibility="Collapsed" MinWidth="168" MinHeight="46" Margin="0" VerticalAlignment="Center"/>
     </Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button x:Name="PingSelectedButton" Content="Пинг" Click="PingSelected_Click" Style="{StaticResource GhostButton}" MinHeight="32" Padding="10,5" Margin="0,0,4,0" IsEnabled="False" ToolTip="Проверить отклик выбранного сервера"/>
       <Button x:Name="PingAllButton" Content="Проверить все" Click="PingAll_Click" Style="{StaticResource GhostButton}" MinHeight="32" Padding="10,5" Margin="0" IsEnabled="False"/>
      </StackPanel><TextBlock Text="Сервер" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <ComboBox x:Name="ServerBox" MinHeight="64" Margin="0" FontSize="14" MaxDropDownHeight="336"
        SelectionChanged="ServerBox_SelectionChanged" AutomationProperties.Name="Сервер VPN">
        <ComboBox.ItemTemplate>
         <DataTemplate>
          <Grid Margin="0,2,4,2">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding ProtocolCaption}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
           </StackPanel>
           <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" Padding="8,4" CornerRadius="6" VerticalAlignment="Center" MinWidth="60" ToolTip="{Binding LatencyDescription}">
            <TextBlock Text="{Binding LatencyText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
             <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding LatencyBand}" Value="Fast"><Setter Property="Foreground" Value="{DynamicResource SuccessInk}"/></DataTrigger>
               <DataTrigger Binding="{Binding LatencyBand}" Value="Medium"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></DataTrigger>
               <DataTrigger Binding="{Binding LatencyBand}" Value="Slow"><Setter Property="Foreground" Value="{DynamicResource StatusWarning}"/></DataTrigger>
              </Style.Triggers>
             </Style></TextBlock.Style>
            </TextBlock>
           </Border>
          </Grid>
         </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.ItemContainerStyle>
         <Style TargetType="ComboBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="9,7"/>
          <Setter Property="Template"><Setter.Value>
           <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ServerRow" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
             <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <Button Grid.Column="1" Click="PingServerRow_Click" Focusable="False" Margin="3,0,0,0" Padding="7,5" ToolTip="Проверить отклик этого сервера" AutomationProperties.Name="Проверить отклик сервера">
               <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
               <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Style.Triggers><DataTrigger Binding="{Binding IsLatencyChecking}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
               </Style></Button.Style>
              </Button>
             </Grid>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ServerRow" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="ServerRow" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value></Setter>
         </Style>
        </ComboBox.ItemContainerStyle>
        <ComboBox.ToolTip><StackPanel><TextBlock Text="{Binding SelectedItem,ElementName=ServerBox}" TextWrapping="Wrap" MaxWidth="310"/><TextBlock Text="{Binding Text,ElementName=ServerHint}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="310" Margin="0,5,0,0"/></StackPanel></ComboBox.ToolTip>
       </ComboBox>
      <TextBlock x:Name="ServerLatencyHint" Text="Отклик сервера по текущему маршруту" Style="{StaticResource FormHint}"/>

      <TextBlock x:Name="ServerHint" Visibility="Collapsed"/>
     </StackPanel></Border>
     <Border Grid.Row="3" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Маршрутизация" FontSize="11" Foreground="{DynamicResource TextMuted}"/><TextBlock x:Name="CoverageHint" Text="Браузер и системный прокси" TextWrapping="Wrap" FontSize="13" Margin="0,4,12,0"/></StackPanel>
      <Button x:Name="CoverageSettingsButton" Grid.Column="1" Content="Маршрутизация →" Click="RoutingLink_Click" Style="{StaticResource GhostButton}" Margin="0" VerticalAlignment="Center"/>
     </Grid></Border>
     <Border x:Name="PendingSettingsBanner" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Применить" Click="ApplyConnectionSettings_Click" Margin="14,0,0,0"/><TextBlock Text="Настройки изменены. Переподключитесь, чтобы применить их." TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/></DockPanel></Border>
    </Grid>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="Подписки" Tag="&#xE8F1;">
   <ScrollViewer x:Name="SubscriptionsPageScroll" Style="{StaticResource PageScroll}"><StackPanel Style="{StaticResource PageStack}">
    <TextBlock Text="Подписки" Style="{StaticResource PageTitle}"/><TextBlock Text="Источники серверов и ваши ссылки подключения." Style="{StaticResource PageDescription}"/>
    <WrapPanel Margin="0,0,0,12"><Button x:Name="NewSubscriptionButton" Content="Добавить ссылку" Click="NewSubscription_Click" Margin="0,0,8,8"/><Button x:Name="EditSubscriptionButton" Content="Изменить" Click="EditSubscription_Click" IsEnabled="False" Style="{StaticResource TertiaryButton}" Margin="0,0,8,8"/><Button x:Name="RemoveSubscriptionButton" Content="Удалить" Click="RemoveSubscription_Click" IsEnabled="False" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><Button x:Name="RefreshAllSubscriptionsButton" Content="Обновить все" Click="RefreshAllSubscriptions_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,8"/></WrapPanel>
    <Expander x:Name="SubscriptionEditor" Header="Добавить подписку" Style="{StaticResource EditorSection}" IsExpanded="False"><StackPanel>
     <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubscriptionNameBox" MaxLength="96" ToolTip="Необязательно. Например: рабочая подписка" Margin="0,0,0,18"/>
     <TextBlock Text="HTTPS-подписка или VLESS-ссылка" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubscriptionBox" MaxLength="8192" AutomationProperties.Name="HTTPS-подписка или VLESS-ссылка" ToolTip="Ссылка сохраняется зашифрованной в профиле Windows"/>
     <TextBlock x:Name="SubscriptionLimitHint" Text="До 100 серверов на одну ссылку. Если их больше, добавим первые 100." Style="{StaticResource FormHint}" Margin="0,8,0,18"/>
     <TextBlock Text="Формат подписки" Style="{StaticResource FieldLabel}"/>
     <ComboBox x:Name="SubscriptionFormatBox" SelectedIndex="0" Margin="0,0,0,20"><ComboBoxItem Tag="auto" Content="Определить автоматически"/><ComboBoxItem Tag="base64" Content="Base64 / V2Ray"/><ComboBoxItem Tag="mihomo" Content="Mihomo / Clash YAML"/><ComboBoxItem Tag="singbox" Content="sing-box JSON"/><ComboBoxItem Tag="xray" Content="Xray JSON"/></ComboBox>
     <WrapPanel><Button x:Name="ImportButton" Content="Добавить подписку" Click="Import_Click" Margin="0,0,8,4"/><Button Content="Отмена" Click="CloseSubscriptionEditor_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,4"/></WrapPanel>
     <TextBlock x:Name="ProfileStatusText" Text="Ссылка хранится зашифрованной в профиле Windows." Style="{StaticResource FormHint}"/>
    </StackPanel></Expander>
    <Expander x:Name="SubscriptionSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="True"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Источники серверов" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ImportSummary" Grid.Column="1" Text="Нет подписок" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"/></Grid></Expander.Header><StackPanel>
     <ListBox x:Name="SubscriptionList" MinHeight="0"
              SelectionChanged="SubscriptionList_SelectionChanged"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Background="Transparent"
              BorderThickness="0"
              Margin="0,0,0,9" Padding="0"
              ToolTip="Выбери подписку для редактирования. Ссылки здесь не показываются.">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template><ListBox.ItemContainerStyle>
       <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
           <Border x:Name="ProfileCard" Background="{DynamicResource ThemeBgEFF5F1}"
                   BorderBrush="{DynamicResource ThemeBorderC9DBD4}" BorderThickness="1"
                   CornerRadius="9" Padding="{TemplateBinding Padding}">
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="*"/>
             </Grid.ColumnDefinitions>
             <Border x:Name="ProfileAccent" Grid.Column="0" Width="4"
                     CornerRadius="2" Background="{DynamicResource RuleSelectedAccent}"
                     Visibility="Collapsed"/>
             <StackPanel Grid.Column="1" Margin="11,0,2,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                         Foreground="{DynamicResource ThemeFg173B3E}"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
               <TextBlock Text="{Binding DetectedFormat}" FontSize="11"
                          Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text="{Binding NodeCount}" FontSize="11"
                          Foreground="{DynamicResource ThemeFg66817C}"/>
               <TextBlock Text=" серверов" FontSize="11" Foreground="{DynamicResource ThemeFg66817C}"/>
              </StackPanel>
             </StackPanel>
            </Grid>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="ProfileCard" Property="Background"
                     Value="{DynamicResource RuleRowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
             <Setter TargetName="ProfileCard" Property="Background"
                     Value="{DynamicResource RuleSelectedBackground}"/>
             <Setter TargetName="ProfileCard" Property="BorderBrush"
                     Value="{DynamicResource RuleSelectedBorder}"/>
             <Setter TargetName="ProfileAccent" Property="Visibility" Value="Visible"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </ListBox.ItemContainerStyle>
     </ListBox>
     <TextBlock x:Name="SubscriptionsEmptyText" Text="Здесь появятся ваши подписки. Нажмите «Добавить ссылку» и вставьте ссылку от провайдера." Style="{StaticResource FormHint}"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Маршрутизация" Tag="&#xE8A5;">
   <ScrollViewer x:Name="RulesPageScroll" Style="{StaticResource PageScroll}"><StackPanel Style="{StaticResource PageStack}">
    <TextBlock Text="Маршрутизация" Style="{StaticResource PageTitle}"/><TextBlock Text="Выберите режим. Добавьте сайты и приложения, для которых нужен отдельный маршрут." Style="{StaticResource PageDescription}"/>
    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
     <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=ModeMigrationNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TextBlock x:Name="ModeMigrationNotice" Text="" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentText}"/>
    </Border>
    <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Режим" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="ModeBox" ItemsSource="{x:Static local:RoutingModes.Options}" DisplayMemberPath="Title" SelectedValuePath="Id"
        SelectionChanged="ModeBox_SelectionChanged" AutomationProperties.Name="Режим VPN" ToolTip="{Binding Text,ElementName=ModeDescription}"/>
      </StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Охват трафика" Style="{StaticResource FieldLabel}"/>
       <CheckBox x:Name="TunBox" Content="Все приложения (TUN)" Click="SettingsChanged_Click" ToolTip="Включено: приложения, игры и UDP. Выключено: системный прокси. Для TUN нужны права администратора." MinHeight="42"/>
       <TextBlock x:Name="CoverageModeHint" Style="{StaticResource FormHint}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="ModeDescription" Style="{StaticResource FormHint}"/>
     <TextBlock x:Name="RoutingSummary" Style="{StaticResource FormHint}" Foreground="{DynamicResource AccentText}"/>
     <Expander x:Name="RoutingSection" Header="Автоматические маршруты" Style="{StaticResource SubSectionStyle}" IsExpanded="False"><StackPanel>
      <CheckBox x:Name="AutoLearnBox" Content="Находить сайты, которым нужен VPN" IsChecked="True" Click="SettingsChanged_Click"/>
      <TextBlock Text="Работает в умном режиме: маршрут меняется после проверки доступности напрямую и через VPN." Style="{StaticResource FormHint}"/>
      <TextBlock x:Name="SettingsApplyHint" Style="{StaticResource FormHint}"/>
      <Button x:Name="ApplySettingsButton" Content="Переподключиться и применить" Click="ApplyConnectionSettings_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,10,0,0"/>
     </StackPanel></Expander>
    </StackPanel></Border>
    <DockPanel Margin="0,0,0,12">
     <Button x:Name="ApplyRulesButton" DockPanel.Dock="Right" Content="Применить" Click="ApplyConnectionSettings_Click" Visibility="Collapsed" Margin="12,0,0,0"/>
     <TextBlock x:Name="RulesApplyStatus" Text="Правила сохраняются автоматически." TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
    </DockPanel>
    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="4" Margin="0,0,0,12"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="SitesRulesButton" Content="Сайты и IP" Click="SitesRules_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,0" AutomationProperties.Name="Показать правила сайтов"/>
     <Button x:Name="ApplicationsRulesButton" Grid.Column="1" Content="Приложения" Click="ApplicationsRules_Click" Style="{StaticResource GhostButton}" Margin="4,0,0,0" AutomationProperties.Name="Показать правила приложений"/>
    </Grid></Border>
    <DockPanel Margin="0,0,0,10">
     <Button x:Name="NewRuleButton" Content="Добавить сайт или IP" Click="NewRule_Click" DockPanel.Dock="Right" Margin="12,0,0,0"/>
     <TextBox x:Name="RuleSearchBox" TextChanged="RuleSearch_Changed" ToolTip="Поиск по адресу или названию" AutomationProperties.Name="Поиск правил"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,12">
     <ComboBox x:Name="RuleSourceBox" DockPanel.Dock="Right" Width="174" SelectedIndex="0" SelectionChanged="RuleSource_Changed" AutomationProperties.Name="Источник правил"><ComboBoxItem Content="Мои правила"/><ComboBoxItem Content="Автоматические"/><ComboBoxItem Content="Все правила"/></ComboBox>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="RuleSearchLabel" Text="Поиск сайтов и IP" Style="{StaticResource FieldLabel}" Margin="0"/><TextBlock x:Name="RuleCountText" Style="{StaticResource FormHint}" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
    <Expander x:Name="RuleGroupsSection" Header="Сохранённые правила" Style="{StaticResource OpenSection}" IsExpanded="True"><StackPanel>
     <TextBlock x:Name="RulesEmptyText" Text="Правила не найдены. Измените поиск или добавьте правило." Visibility="Collapsed" Style="{StaticResource FormHint}" Margin="0,0,0,12"/>
     <ListBox x:Name="RulesList" Background="Transparent" Foreground="{DynamicResource ThemeFg1A3E42}"

                 BorderThickness="0" FontSize="12.5" KeyboardNavigation.TabNavigation="Continue"

                 SelectionChanged="RulesList_SelectionChanged">

         <ListBox.Template>

          <ControlTemplate TargetType="{x:Type ListBox}">

           <ItemsPresenter/>

          </ControlTemplate>

         </ListBox.Template>

         <ListBox.ItemContainerStyle>
          <Style TargetType="{x:Type ListBoxItem}">
           <Setter Property="Padding" Value="9,5"/>
           <Setter Property="Margin" Value="0,0,0,2"/>
           <Setter Property="FontSize" Value="12"/>
           <Setter Property="Foreground" Value="{DynamicResource ThemeFg1A3E42}"/>
           <Setter Property="Background" Value="Transparent"/>
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
           <Setter Property="Cursor" Value="Hand"/>
           <EventSetter Event="PreviewMouseRightButtonDown" Handler="RuleItem_RightButtonDown"/>
           <Setter Property="ContextMenu">
            <Setter.Value>
             <ContextMenu/>
            </Setter.Value>
           </Setter>
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border x:Name="RuleRowFrame" Background="{TemplateBinding Background}"
                      BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="6" Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
               <Grid>
                <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="4"/>
                 <ColumnDefinition Width="*"/>
                 <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="RuleSelectedMarker" Grid.Column="0"
                        Background="{DynamicResource RuleSelectedAccent}"
                        Width="4" CornerRadius="2" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Margin="7,0,0,0" ToolTip="{Binding DisplaySummary}"><TextBlock x:Name="RuleRowText" Text="{Binding DisplayTarget}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
                 <TextBlock Text="{Binding CompactSummary}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource ThemeFg66817C}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="6" Padding="9,5" Margin="12,0,0,0" VerticalAlignment="Center">
                 <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Style.Triggers>
                  <DataTrigger Binding="{Binding Route}" Value="VEGA"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger>
                  <DataTrigger Binding="{Binding Route}" Value="REJECT"><Setter Property="Background" Value="{DynamicResource DangerSoft}"/></DataTrigger>
                 </Style.Triggers></Style></Border.Style>
                 <TextBlock Text="{Binding RouteCaption}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
               </Grid>
              </Border>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RuleRowFrame" Property="Background"
                        Value="{DynamicResource RuleRowHover}"/>
               </Trigger>
               <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="RuleRowFrame" Property="BorderBrush"
                        Value="{DynamicResource RuleSelectedBorder}"/>
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RuleRowFrame" Property="Background"
                        Value="{DynamicResource RuleSelectedBackground}"/>
                <Setter TargetName="RuleRowFrame" Property="BorderBrush"
                        Value="{DynamicResource RuleSelectedBorder}"/>
                <Setter TargetName="RuleSelectedMarker" Property="Visibility"
                        Value="Visible"/>
                <Setter TargetName="RuleRowText" Property="Foreground"
                        Value="{DynamicResource RuleSelectedForeground}"/>
                <Setter TargetName="RuleRowText" Property="FontWeight"
                        Value="SemiBold"/>
               </Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </ListBox.ItemContainerStyle>
         <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle>
          <Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value>
           <ControlTemplate TargetType="GroupItem">
            <Expander Style="{StaticResource CompactRuleGroupStyle}" IsExpanded="True" Loaded="RuleGroup_Loaded"
             Expanded="RuleGroup_ExpansionChanged" Collapsed="RuleGroup_ExpansionChanged">
             <Expander.Header><DockPanel>
              <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="7,2" Margin="12,0,0,0">
               <TextBlock Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
             </DockPanel></Expander.Header>
             <ItemsPresenter/>
            </Expander>
           </ControlTemplate>
          </Setter.Value></Setter></Style>
         </GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>



        </ListBox>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"><StackPanel>
      <TextBlock x:Name="SelectedRuleHint" Text="Выберите правило для изменения или удаления" Style="{StaticResource FormHint}" Margin="0,0,0,12"/>
      <WrapPanel><Button x:Name="EditRuleButton" Content="Изменить" Click="EditRule_Click" IsEnabled="False" Style="{StaticResource TertiaryButton}" Margin="0,0,8,4"/><Button x:Name="RemoveRuleButton" Content="Удалить выбранное" Click="RemoveRule_Click" IsEnabled="False" Style="{StaticResource DangerButton}" Margin="0,0,0,4"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Настройки" Tag="&#xE713;">
   <ScrollViewer x:Name="SettingsPageScroll" Style="{StaticResource PageScroll}"><StackPanel Style="{StaticResource PageStack}">
    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/><TextBlock Text="Дополнительные параметры сети и обновления приложения." Style="{StaticResource PageDescription}"/>
     <Expander x:Name="TunAdvancedSection" Header="Дополнительные настройки TUN" Style="{StaticResource CompactSectionStyle}" IsExpanded="False">
      <StackPanel Margin="14,10,8,6">
       <TextBlock Text="Сетевой стек" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="TunStackBox" SelectedIndex="0" SelectionChanged="TunStack_SelectionChanged" AutomationProperties.Name="Сетевой стек TUN">
        <ComboBoxItem Content="Совместимый — mixed (рекомендуется)" Tag="mixed"/>
        <ComboBoxItem Content="Системный — system" Tag="system"/>
        <ComboBoxItem Content="Виртуальный — gVisor" Tag="gvisor"/>
       </ComboBox>
       <TextBlock Text="При проблемах с играми или UDP попробуйте другой стек. Для применения нужно переподключиться." Style="{StaticResource FormHint}"/>
       <CheckBox x:Name="TunDnsHijackBox" Content="Перехватывать DNS-запросы (порт 53)" IsChecked="True" Click="SettingsChanged_Click" Margin="0,14,0,0"/>
       <TextBlock Text="По умолчанию включено, чтобы доменные правила работали даже при собственных DNS-запросах приложений. Не охватывает DNS через HTTPS." Style="{StaticResource FormHint}" Margin="45,4,0,0"/>
       <CheckBox x:Name="TunStrictRouteBox" Content="Строгая маршрутизация" Click="SettingsChanged_Click" Margin="0,14,0,0"/>
       <TextBlock Text="Может уменьшить обход TUN, но повлиять на локальную сеть, DNS и совместимость. Оставьте выключенным, если не требуется." Style="{StaticResource FormHint}" Margin="45,4,0,0"/>
      </StackPanel>
     </Expander>
    <Expander x:Name="UpdateSection" Style="{StaticResource CompactSectionStyle}" IsExpanded="True"><Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Обновления" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Grid.Column="1" Text="Не проверено" FontSize="11" Foreground="{DynamicResource TextMuted}" MaxWidth="240" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Expander.Header><StackPanel>
     <TextBlock Text="Официальные стабильные версии с GitHub. Установка начнётся после вашего подтверждения." Style="{StaticResource FormHint}" Margin="0,0,0,16"/>
     <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Click="CheckUpdate_Click" Style="{StaticResource TertiaryButton}" HorizontalAlignment="Left" Margin="0"/>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
  <TabItem Header="Диагностика" Tag="&#xE897;">
   <ScrollViewer x:Name="HelpPageScroll" Style="{StaticResource PageScroll}"><StackPanel Style="{StaticResource PageStack}">
    <TextBlock Text="Помощь и диагностика" Style="{StaticResource PageTitle}"/><TextBlock Text="Проверка подключения, маршрутов и журнал событий — в одном месте." Style="{StaticResource PageDescription}"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Состояние" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="StatusLabel" Text="Не подключено" TextWrapping="Wrap" FontSize="14"/><WrapPanel Margin="0,18,0,0"><Button Content="Добавить серверы" Click="SubscriptionsLink_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,8,6"/><Button Content="Настроить маршрутизацию" Click="RoutingLink_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border>
    <Expander x:Name="ConnectionDetailsSection" Header="Сведения о подключении" Style="{StaticResource CompactSectionStyle}" IsExpanded="False"><StackPanel>
     <TextBlock x:Name="RecoveryText" Text="Подключитесь, чтобы начать проверку." Style="{StaticResource FormHint}" Margin="0,0,0,12"/><TextBlock x:Name="LatencyText" Text="HTTPS-задержка: нет данных" Style="{StaticResource FormHint}" Margin="0,0,0,12"/><TextBlock x:Name="UdpText" Text="UDP: нет данных" Style="{StaticResource FormHint}" Margin="0,0,0,12"/><TextBlock x:Name="EngineInfoLabel" Text="Ядро выбирается автоматически." Style="{StaticResource FormHint}" Margin="0,0,0,16"/>
     <Button x:Name="RefreshButton" Content="Обновить список серверов" Click="Refresh_Click" Style="{StaticResource TertiaryButton}" HorizontalAlignment="Left" Margin="0"/>
    </StackPanel></Expander>
    <Expander x:Name="QualitySection" Header="Диагностика Discord и UDP" Style="{StaticResource CompactSectionStyle}" IsExpanded="False">
     <StackPanel>
      <TextBlock Text="Запускаемая вручную проверка HTTPS через выбранный VPN. Колебания измерений не равны задержке голоса Discord. Реальные потери UDP-пакетов здесь не измеряются." Style="{StaticResource FormHint}" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,14">
       <Button x:Name="QualityStartButton" Content="Начать диагностику" Click="QualityToggle_Click" Margin="0,0,8,5"/>
       <Button x:Name="QualityResetButton" Content="Очистить" Click="QualityClear_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,8,5"/>
       <Button x:Name="QualityCopyButton" Content="Скопировать отчёт" Click="QualityCopy_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,5"/>
      </WrapPanel>
      <TextBlock x:Name="QualityStatusText" Text="Подключитесь к VPN и нажмите «Начать диагностику»." Style="{StaticResource FormHint}" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,12">
       <StackPanel Width="180" Margin="0,0,12,10">
        <TextBlock Text="Последняя HTTPS-задержка" Style="{StaticResource FieldLabel}"/>
        <TextBlock x:Name="QualityCurrentText" Text="—" FontSize="20" FontWeight="SemiBold"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,12,10">
        <TextBlock Text="Среднее изменение задержки" Style="{StaticResource FieldLabel}"/>
        <TextBlock x:Name="QualityVariationText" Text="—" FontSize="20" FontWeight="SemiBold"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,12,10">
        <TextBlock Text="Максимальная задержка" Style="{StaticResource FieldLabel}"/>
        <TextBlock x:Name="QualityPeakText" Text="—" FontSize="20" FontWeight="SemiBold"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,12,10">
        <TextBlock Text="Сбои HTTPS-проверок" Style="{StaticResource FieldLabel}"/>
        <TextBlock x:Name="QualityFailuresText" Text="—" FontSize="20" FontWeight="SemiBold"/>
       </StackPanel>
      </WrapPanel>
      <Border Background="{DynamicResource SurfaceRaised}" Padding="8" CornerRadius="8" ClipToBounds="True">
       <Canvas x:Name="QualityCanvas" Height="132" SizeChanged="QualityCanvas_SizeChanged" ClipToBounds="True"/>
      </Border>
      <TextBlock x:Name="QualityGraphHint" Text="Пока нет измерений" Style="{StaticResource FormHint}" Margin="0,7,0,16"/>
      <TextBlock x:Name="QualityUdpRoutesText" Text="Discord UDP: данные появятся после подключения." Style="{StaticResource FormHint}" Margin="0,0,0,8"/>
      <TextBlock Text="Маршрут UDP показывается по цепочке Mihomo: VPN, DIRECT или неизвестен. Данные о джиттере и потере пакетов внутри голосового канала Discord недоступны без отдельной голосовой диагностики." Style="{StaticResource FormHint}" Margin="0"/>
     </StackPanel>
    </Expander>
    <Expander x:Name="ProbeSection" Header="Проверить сайт" Style="{StaticResource CompactSectionStyle}" IsExpanded="False"><StackPanel>
     <TextBlock Text="Адрес сайта" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProbeBox" AutomationProperties.Name="Сайт для проверки" ToolTip="Например: example.com"/>
     <WrapPanel Margin="0,14,0,0"><Button Content="Сравнить маршруты" Click="Probe_Click" Margin="0,0,8,6"/><Button Content="Подобрать маршрут" Click="AutoRoute_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,6"/></WrapPanel>
     <TextBlock x:Name="ProbeResult" Text="Подключитесь к VPN и введите адрес. Сравним доступ напрямую и через сервер." Style="{StaticResource FormHint}"/>
    </StackPanel></Expander>
    <Expander x:Name="LogSection" Header="События подключения" Style="{StaticResource CompactSectionStyle}" IsExpanded="False"><Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="10"><TextBox x:Name="LogBox" MinHeight="200" MaxHeight="320" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="4"/></Border></Expander>
   </StackPanel></ScrollViewer>
  </TabItem>
 </TabControl>
 <Border x:Name="RuleEditorOverlay" Background="#66000000" Padding="24" KeyboardNavigation.TabNavigation="Cycle">
  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded,ElementName=AddRuleSection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
  <Grid MaxWidth="640"><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="RuleEditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
    <Expander x:Name="AddRuleSection" Header="Новое правило" Style="{StaticResource EditorSection}" IsExpanded="False"><StackPanel>
     <TextBlock x:Name="RuleTargetKindLabel" Visibility="Collapsed"/>
     <ComboBox x:Name="RuleTargetKindBox" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="RuleTargetKind_Changed"><ComboBoxItem Content="Сайт / IP" Tag="address"/><ComboBoxItem Content="Приложение" Tag="application"/></ComboBox>
     <TextBlock x:Name="RuleTargetCaption" Text="Адрес сайта или IP" Style="{StaticResource FieldLabel}"/>
     <DockPanel LastChildFill="True"><Button x:Name="ChooseApplicationButton" DockPanel.Dock="Right" Content="Выбрать .exe…" Click="ChooseApplication_Click" Visibility="Collapsed" Style="{StaticResource TertiaryButton}" Margin="8,0,0,0"/><TextBox x:Name="DomainBox" TextChanged="DomainBox_TextChanged" AutomationProperties.Name="Сайт, IP-адрес или подсеть" ToolTip="Например: example.com, 8.8.8.8 или 1.2.3.0/24"/></DockPanel>
     <TextBlock x:Name="ApplicationRuleHint" Visibility="Collapsed" Text="Введите имя процесса (chrome.exe) или выберите файл. Для всех соединений приложения включите TUN с правами администратора." Style="{StaticResource FormHint}"/>
     <TextBlock x:Name="RuleAddressHint" Text="Поддерживаются домены, IPv4, IPv6 и подсети CIDR." Style="{StaticResource FormHint}"/>
     <StackPanel x:Name="DomainScopeSection" Visibility="Collapsed" Margin="0,14,0,0">
      <TextBlock Text="Охват домена" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="DomainScopeBox" SelectedIndex="0" AutomationProperties.Name="Охват домена">
       <ComboBoxItem Content="Домен и все поддомены" Tag="suffix"/>
       <ComboBoxItem Content="Только указанный адрес" Tag="exact"/>
      </ComboBox>
      <TextBlock Text="Например: example.com и api.example.com или только указанный вами адрес." Style="{StaticResource FormHint}"/>
     </StackPanel>
     <StackPanel Margin="0,14,0,14"><TextBlock Text="Маршрут" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="RuleRouteBox" SelectedIndex="0" SelectionChanged="RuleRouteBox_SelectionChanged"><ComboBoxItem Content="Напрямую" Tag="DIRECT"/><ComboBoxItem Content="Через VPN" Tag="VEGA"/><ComboBoxItem Content="Блокировать" Tag="REJECT"/></ComboBox>
     </StackPanel>
     <Expander x:Name="RuleAdvancedSection" Header="Название и отдельный сервер" Style="{StaticResource SubSectionStyle}" IsExpanded="False"><StackPanel>
      <TextBlock Text="Название · необязательно" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RuleLabelBox" MaxLength="96" Margin="0,0,0,14"/>
      <TextBlock Text="Сервер VPN" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RuleNodeBox" IsEnabled="False"/>
     </StackPanel></Expander>
     <CheckBox x:Name="MyRuleEnabledBox" Content="Включить в режим «Только выбранное»"
               IsChecked="True" Margin="0,0,0,12" ToolTip="В режиме «Только выбранное» применяются только включённые правила. В остальных режимах действуют все ручные правила."/>
     <TextBlock x:Name="RuleValidationText" Foreground="{DynamicResource StatusWarning}" TextWrapping="Wrap" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <WrapPanel><Button x:Name="SaveRuleButton" Content="Сохранить" Click="AddRule_Click" Margin="0,0,8,4"/><Button Content="Отмена" Click="CloseRuleEditor_Click" Style="{StaticResource TertiaryButton}" Margin="0,0,0,4"/></WrapPanel>
    </StackPanel></Expander>
   </ScrollViewer>
  </Grid>
 </Border>
 <local:OnboardingView x:Name="OnboardingPanel" Visibility="Collapsed"/>
 </Grid>
 </Grid></Border>
